generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  username         String       @unique
  passwordHash     String       @map("password_hash")
  twoFaSecret      String?      @map("two_fa_secret")
  twoFaEnabled     Boolean      @default(false) @map("two_fa_enabled")
  refreshToken     String?      @map("refresh_token")
  avatarUrl        String?      @map("avatar_url")
  petUrl           String?      @map("pet_url")
  xp               Int          @default(0)
  coins            Int          @default(0)
  level            Int          @default(1)
  streak           Int          @default(0)
  longestStreak    Int          @default(0) @map("longest_streak")
  lastPlayedAt     DateTime?    @map("last_played_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")
  receivedRequests Friendship[]  @relation("ReceivedRequests")
  sentRequests     Friendship[]  @relation("SentRequests")
  quizzes          Quiz[]
  matchPlayers     MatchPlayer[]
  userItems        UserItem[]
  userBoosts       UserBoost[]
  rankedJourneys   RankedJourney[]

  @@map("users")
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String           @map("sender_id")
  receiverId String           @map("receiver_id")
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  receiver   User             @relation("ReceivedRequests", fields: [receiverId], references: [id])
  sender     User             @relation("SentRequests", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum QuizTheme {
  SPACE
  HISTORY
  PROGRAMMING
  SCIENCE
  GEOGRAPHY
  LITERATURE
  MATH
  GENERAL
  CUSTOM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model Quiz {
  id              String     @id @default(uuid())
  title           String
  theme           QuizTheme  @default(GENERAL)
  difficulty      Difficulty @default(MEDIUM)
  numQuestions    Int        @map("num_questions")
  timePerQuestion Int        @default(30) @map("time_per_question")
  createdById     String     @map("created_by_id")
  sourceType      String     @default("prompt") @map("source_type")
  createdAt       DateTime   @default(now()) @map("created_at")

  createdBy  User       @relation(fields: [createdById], references: [id])
  questions  Question[]
  matches    Match[]
  rankedStages RankedStage[]

  @@map("quizzes")
}

model Question {
  id            String  @id @default(uuid())
  quizId        String  @map("quiz_id")
  text          String
  options       Json
  correctAnswer Int     @map("correct_answer")
  explanation   String?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  content    String
  embedding  Bytes    @map("embedding")
  sourceFile String   @map("source_file")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("document_chunks")
}

// ── Game Engine ──────────────────────────────────────────

enum MatchType {
  PVP
  COOP
  RANKED
  SOLO
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Match {
  id         String      @id @default(uuid())
  type       MatchType
  status     MatchStatus @default(WAITING)
  quizId     String      @map("quiz_id")
  inviteCode String?     @unique @map("invite_code")
  createdAt  DateTime    @default(now()) @map("created_at")
  endedAt    DateTime?   @map("ended_at")

  quiz    Quiz          @relation(fields: [quizId], references: [id])
  players MatchPlayer[]

  @@map("matches")
}

model MatchPlayer {
  id       String  @id @default(uuid())
  matchId  String  @map("match_id")
  userId   String  @map("user_id")
  score    Int     @default(0)
  isWinner Boolean @default(false) @map("is_winner")
  answers  Json?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@map("match_players")
}

// ── Shop & Avatar ────────────────────────────────────────

enum ItemType {
  HAT
  ARMOR
  WEAPON
  SHIELD
  BADGE
  PET
  AVATAR
}

model Item {
  id        String   @id @default(uuid())
  name      String
  type      ItemType
  imagePath String   @map("image_path")
  price     Int
  minLevel  Int      @default(1) @map("min_level")

  userItems UserItem[]

  @@map("items")
}

model UserItem {
  id         String  @id @default(uuid())
  userId     String  @map("user_id")
  itemId     String  @map("item_id")
  isEquipped Boolean @default(false) @map("is_equipped")

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
  @@map("user_items")
}

// ── Boosts ───────────────────────────────────────────────

enum BoostType {
  HINT
  EXTRA_TIME
  FIFTY_FIFTY
  DOUBLE_POINTS
  SHIELD
  STREAK_FREEZE
}

model UserBoost {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  type     BoostType
  quantity Int       @default(1)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("user_boosts")
}

// ── Ranked Journey ───────────────────────────────────────

model RankedJourney {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  topic        String
  totalStages  Int      @map("total_stages")
  currentStage Int      @default(0) @map("current_stage")
  isCompleted  Boolean  @default(false) @map("is_completed")
  createdAt    DateTime @default(now()) @map("created_at")

  user   User          @relation(fields: [userId], references: [id])
  stages RankedStage[]

  @@map("ranked_journeys")
}

model RankedStage {
  id           String     @id @default(uuid())
  journeyId    String     @map("journey_id")
  stageNumber  Int        @map("stage_number")
  quizId       String     @map("quiz_id")
  difficulty   Difficulty
  isCompleted  Boolean    @default(false) @map("is_completed")
  score        Int?
  earnedReward Json?      @map("earned_reward")

  journey RankedJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  quiz    Quiz          @relation(fields: [quizId], references: [id])

  @@map("ranked_stages")
}
