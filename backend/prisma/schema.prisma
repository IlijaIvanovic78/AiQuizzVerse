generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  username         String       @unique
  passwordHash     String       @map("password_hash")
  twoFaSecret      String?      @map("two_fa_secret")
  twoFaEnabled     Boolean      @default(false) @map("two_fa_enabled")
  refreshToken     String?      @map("refresh_token")
  avatarUrl        String?      @map("avatar_url")
  xp               Int          @default(0)
  coins            Int          @default(0)
  level            Int          @default(1)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")
  receivedRequests Friendship[]  @relation("ReceivedRequests")
  sentRequests     Friendship[]  @relation("SentRequests")
  quizzes          Quiz[]
  matchPlayers     MatchPlayer[]

  @@map("users")
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String           @map("sender_id")
  receiverId String           @map("receiver_id")
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  receiver   User             @relation("ReceivedRequests", fields: [receiverId], references: [id])
  sender     User             @relation("SentRequests", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum QuizTheme {
  SPACE
  HISTORY
  PROGRAMMING
  SCIENCE
  GEOGRAPHY
  LITERATURE
  MATH
  GENERAL
  CUSTOM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model Quiz {
  id              String     @id @default(uuid())
  title           String
  theme           QuizTheme  @default(GENERAL)
  difficulty      Difficulty @default(MEDIUM)
  numQuestions    Int        @map("num_questions")
  timePerQuestion Int        @default(30) @map("time_per_question")
  createdById     String     @map("created_by_id")
  sourceType      String     @default("prompt") @map("source_type")
  createdAt       DateTime   @default(now()) @map("created_at")

  createdBy  User       @relation(fields: [createdById], references: [id])
  questions  Question[]
  matches    Match[]

  @@map("quizzes")
}

model Question {
  id            String  @id @default(uuid())
  quizId        String  @map("quiz_id")
  text          String
  options       Json
  correctAnswer Int     @map("correct_answer")
  explanation   String?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  content    String
  embedding  Bytes    @map("embedding")
  sourceFile String   @map("source_file")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("document_chunks")
}

// ── Game Engine ──────────────────────────────────────────

enum MatchType {
  PVP
  COOP
  RANKED
  SOLO
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Match {
  id         String      @id @default(uuid())
  type       MatchType
  status     MatchStatus @default(WAITING)
  quizId     String      @map("quiz_id")
  inviteCode String?     @unique @map("invite_code")
  createdAt  DateTime    @default(now()) @map("created_at")
  endedAt    DateTime?   @map("ended_at")

  quiz    Quiz          @relation(fields: [quizId], references: [id])
  players MatchPlayer[]

  @@map("matches")
}

model MatchPlayer {
  id       String  @id @default(uuid())
  matchId  String  @map("match_id")
  userId   String  @map("user_id")
  score    Int     @default(0)
  isWinner Boolean @default(false) @map("is_winner")
  answers  Json?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@map("match_players")
}
