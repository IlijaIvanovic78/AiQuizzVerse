generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Audience {
  KIDS
  TEENS
  ADULTS
}

enum QuizLanguage {
  EN
  SR
}

enum QuizTheme {
  SPACE
  HISTORY
  SCIENCE
  NATURE
  GEOGRAPHY
  MATH
  LANGUAGE
  ART
  MUSIC
  SPORTS
  TECHNOLOGY
  GENERAL
}

enum QuizKind {
  STANDARD
  PATH_STEP
  REVIEW
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum MatchMode {
  SOLO
  DUEL
  TEAM
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum ItemType {
  AVATAR
  PET
}

enum BoostType {
  HINT
  FIFTY_FIFTY
  EXTRA_TIME
  STREAK_FREEZE
}

enum PurchaseStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String    @unique
  passwordHash     String    @map("password_hash")
  twoFaSecret      String?   @map("two_fa_secret")
  twoFaEnabled     Boolean   @default(false) @map("two_fa_enabled")
  refreshTokenHash String?   @map("refresh_token_hash")
  avatarKey        String?   @map("avatar_key")
  petKey           String?   @map("pet_key")
  xp               Int       @default(0)
  coins            Int       @default(100)
  streak           Int       @default(0)
  longestStreak    Int       @default(0) @map("longest_streak")
  lastPlayedOn     DateTime? @map("last_played_on") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sentRequests     Friendship[]   @relation("SentRequests")
  receivedRequests Friendship[]   @relation("ReceivedRequests")
  documents        Document[]
  quizzes          Quiz[]
  paths            LearningPath[]
  hostedMatches    Match[]
  matchPlayers     MatchPlayer[]
  reviewCards      ReviewCard[]
  items            UserItem[]
  boosts           UserBoost[]
  purchases        Purchase[]

  @@map("users")
}

model Friendship {
  id         String           @id @default(uuid())
  senderId   String           @map("sender_id")
  receiverId String           @map("receiver_id")
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
  @@map("friendships")
}

model Document {
  id             String   @id @default(uuid())
  ownerId        String   @map("owner_id")
  fileName       String   @map("file_name")
  content        String
  characterCount Int      @map("character_count")
  createdAt      DateTime @default(now()) @map("created_at")

  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  quizzes Quiz[]
  paths   LearningPath[]

  @@index([ownerId])
  @@map("documents")
}

model Quiz {
  id              String       @id @default(uuid())
  title           String
  topic           String
  theme           QuizTheme
  difficulty      Difficulty
  audience        Audience
  language        QuizLanguage
  kind            QuizKind     @default(STANDARD)
  timePerQuestion Int          @map("time_per_question")
  ownerId         String       @map("owner_id")
  documentId      String?      @map("document_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  document  Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  questions Question[]
  matches   Match[]
  pathStep  PathStep?

  @@index([ownerId, kind])
  @@map("quizzes")
}

model Question {
  id               String   @id @default(uuid())
  quizId           String   @map("quiz_id")
  position         Int
  text             String
  options          String[]
  correctIndex     Int      @map("correct_index")
  explanation      String
  hint             String
  sourceQuestionId String?  @map("source_question_id")

  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  reviewCards ReviewCard[]

  @@unique([quizId, position])
  @@map("questions")
}

model LearningPath {
  id         String       @id @default(uuid())
  ownerId    String       @map("owner_id")
  topic      String
  documentId String?      @map("document_id")
  audience   Audience
  language   QuizLanguage
  createdAt  DateTime     @default(now()) @map("created_at")

  owner    User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  document Document?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  steps    PathStep[]

  @@index([ownerId])
  @@map("learning_paths")
}

model PathStep {
  id           String     @id @default(uuid())
  pathId       String     @map("path_id")
  position     Int
  title        String
  keyPoints    String[]   @map("key_points")
  difficulty   Difficulty
  quizId       String     @unique @map("quiz_id")
  stars        Int        @default(0)
  bestAccuracy Int        @default(0) @map("best_accuracy")
  completedAt  DateTime?  @map("completed_at")

  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  quiz Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([pathId, position])
  @@map("path_steps")
}

model Match {
  id         String      @id @default(uuid())
  mode       MatchMode
  status     MatchStatus @default(WAITING)
  quizId     String      @map("quiz_id")
  hostId     String      @map("host_id")
  inviteCode String?     @unique @map("invite_code")
  stepReward Json?       @map("step_reward")
  createdAt  DateTime    @default(now()) @map("created_at")
  startedAt  DateTime?   @map("started_at")
  endedAt    DateTime?   @map("ended_at")

  quiz    Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  host    User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  players MatchPlayer[]

  @@index([status])
  @@map("matches")
}

model MatchPlayer {
  id           String   @id @default(uuid())
  matchId      String   @map("match_id")
  userId       String   @map("user_id")
  score        Int      @default(0)
  correctCount Int      @default(0) @map("correct_count")
  isWinner     Boolean  @default(false) @map("is_winner")
  xpEarned     Int      @default(0) @map("xp_earned")
  coinsEarned  Int      @default(0) @map("coins_earned")
  leveledUp    Boolean  @default(false) @map("leveled_up")
  answers      Json     @default("[]")
  joinedAt     DateTime @default(now()) @map("joined_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
  @@map("match_players")
}

model ReviewCard {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  questionId    String   @map("question_id")
  timesWrong    Int      @default(1) @map("times_wrong")
  correctStreak Int      @default(0) @map("correct_streak")
  dueOn         DateTime @map("due_on") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, dueOn])
  @@map("review_cards")
}

model Item {
  id        String   @id
  name      String
  type      ItemType
  price     Int
  minLevel  Int      @default(1) @map("min_level")
  isStarter Boolean  @default(false) @map("is_starter")

  owners UserItem[]

  @@map("items")
}

model UserItem {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  itemId     String   @map("item_id")
  acquiredAt DateTime @default(now()) @map("acquired_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("user_items")
}

model UserBoost {
  id       String    @id @default(uuid())
  userId   String    @map("user_id")
  type     BoostType
  quantity Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("user_boosts")
}

model Purchase {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  packageId   String         @map("package_id")
  coins       Int
  amountCents Int            @map("amount_cents")
  currency    String
  status      PurchaseStatus @default(PENDING)
  provider    String
  providerRef String?        @map("provider_ref")
  createdAt   DateTime       @default(now()) @map("created_at")
  paidAt      DateTime?      @map("paid_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("purchases")
}
