# Copy this file to .env and fill in the values.

# Database
POSTGRES_USER=quizverse
POSTGRES_PASSWORD=quizverse
POSTGRES_DB=quizverse
POSTGRES_PORT=5432

# Backend (DATABASE_URL is used when the backend runs outside Docker)
DATABASE_URL=postgresql://quizverse:quizverse@localhost:5432/quizverse?schema=public
BACKEND_PORT=3000
FRONTEND_URL=http://localhost:4200
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AI quiz generation
OPENAI_API_KEY=

# Frontend
FRONTEND_PORT=4200
